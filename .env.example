# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Assistant identity
ASSISTANT_NAME=Casper

# The only required API key (reasoning and tool use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Local speech-to-text (faster-whisper, no key). "base" is faster, "small" more accurate.
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=de

# Text-to-speech (edge-tts, no key). Alternative: de-DE-KillianNeural
TTS_VOICE=de-DE-ConradNeural

# Weather tool (Open-Meteo, no key required). Used whenever you name no place.
DEFAULT_CITY=Ulm

# PowerPoint tool: folder that is searched recursively for .pptx files
# Example (Windows): PPTX_SEARCH_DIR="C:\Users\you\Documents\Presentations"
# Example (macOS/Linux): PPTX_SEARCH_DIR="/home/you/Presentations"
PPTX_SEARCH_DIR=

# Microsoft account (calendar, To Do, e-mail via Microsoft Graph).
# Leave MS_CLIENT_ID empty to use the local mock data instead.
# Register an app once, then run `python auth_microsoft.py` to sign in (see README).
MS_CLIENT_ID=
# Directory (tenant) ID for work accounts. Leave empty for personal accounts.
MS_TENANT_ID=

# Gmail (optional). Put the OAuth client file from Google Cloud Console next to the code
# as credentials.json, then run `python auth_google.py` once. Without the file the Gmail
# tools stay off. The token is stored in token_google.json.
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_TOKEN_FILE=token_google.json

# Web search region (DuckDuckGo) and the train-connection API (no key needed)
SEARCH_REGION=de-de
TRANSIT_API_URL=https://v6.db.transport.rest

# Local timezone for dates, calendar events, alarms and the system prompt
TIMEZONE=Europe/Berlin
