# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Assistant identity
ASSISTANT_NAME=Casper

# API keys (required for speech and reasoning)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models and voice (defaults shown)
ANTHROPIC_MODEL=claude-haiku-5-5
STT_LANGUAGE=de
TTS_VOICE=onyx
TTS_RESPONSE_FORMAT=wav

# Weather tool (Open-Meteo, no key required)
DEFAULT_CITY="Frankfurt am Main"

# PowerPoint tool: folder that is searched recursively for .pptx files
# Example (Windows): PPTX_SEARCH_DIR="C:\Users\you\Documents\Presentations"
# Example (macOS/Linux): PPTX_SEARCH_DIR="/home/you/Presentations"
PPTX_SEARCH_DIR=

# Microsoft Graph placeholders (not used by the mock services yet)
MS_CLIENT_ID=
MS_TENANT_ID=

# Local timezone for dates, calendar events and the system prompt
TIMEZONE=Europe/Berlin
